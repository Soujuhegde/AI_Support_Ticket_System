# Copy this file to .env and fill in your own free Groq API key.
# Get one at: https://console.groq.com/keys

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides (sensible defaults are used if left blank)
CSV_PATH=data/support_tickets.csv
ANOMALY_RESOLUTION_PERCENTILE=90
ANOMALY_STALE_HOURS=24
